
CREATE DATABASE bloodbank;
USE bloodbank;

CREATE TABLE donors (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100),
    age INT,
    gender VARCHAR(20),
    blood_group VARCHAR(5),
    phone VARCHAR(15),
    city VARCHAR(100)
);

CREATE TABLE blood_requests (
    id INT AUTO_INCREMENT PRIMARY KEY,
    patient_name VARCHAR(100),
    blood_group VARCHAR(5),
    units INT,
    hospital VARCHAR(100),
    request_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
